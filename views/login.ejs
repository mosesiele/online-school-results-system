<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mpongwe School Results Portal</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="container" style="max-width: 460px; margin: 80px auto;">
      <div class="card">
        <div style="text-align: center; margin-bottom: 24px;">
          <h1 style="margin-bottom: 8px;">Mpongwe Day Secondary School</h1>
          <p style="margin: 0; color: #64748b;">Results Management System</p>
        </div>

        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/login">
          <div class="field" style="margin-bottom: 16px;">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" placeholder="Enter username" required />
          </div>

          <div class="field" style="margin-bottom: 16px;">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" placeholder="Enter password" required />
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">Login</button>
        </form>

        <div style="margin-top: 20px; color: #64748b; font-size: 0.92rem;">
          Demo accounts:<br />
          Admin: admin / admin123<br />
          Teacher: teacher / teacher123<br />
          Department: department / dept123
        </div>
      </div>
    </div>
  </body>
</html>
